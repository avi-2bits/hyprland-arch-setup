{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    // --- MODULE LAYOUT ---
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/kew",
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "clock"
    ],
    // --- LEFT MODULES ---
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "all-outputs": true,
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": []
        }
    },
    "custom/kew": {
        "format": "{}",
        "return-type": "json",
        "interval": 2,
        "exec": "~/.config/waybar/scripts/kew-waybar.sh",
        // Escaped double-quotes inside JSON to prevent Foot / Waybar parsing issues
        "on-click": "foot -a kew_floating -T \"kew\" -e kew",
        "on-click-right": "playerctl -p kew play-pause",
        "tooltip": false
    },

        // --- RIGHT MODULES ---
    "network": {
        "interface": "wlp2s0",
        "format-wifi": "{essid} ::",
        "format-disconnected": "net offline ::",
        "tooltip": false
    },
    "cpu": {
        "interval": 5,
        "format": "cpu {usage}% ::"
    },
    "memory": {
        "interval": 5,
        "format": "ram {used:0.1f}g ::"
    },
    "pulseaudio": {
        "format": "vol {volume}% ::",
        "format-muted": "vol mute ::"
    },
    "battery": {
        "interval": 10,
        "format": "bat {capacity}% ::",
        "format-charging": "bat {capacity}% (chg) ::",
        "format-plugged": "bat {capacity}% (plg) ::"
    },
    "clock": {
        "format": "{:%d.%b :: %H:%M}"
    }
}

