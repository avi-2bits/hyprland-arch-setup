/* ~/.config/rofi/config.rasi */
@import "~/.cache/matugen/colors-rofi.rasi"

configuration {
    modi:                "drun,run";
    show-icons:          false;
    drun-display-format: "{name}";
    matching:            "fuzzy";
    scroll-method:       0;
    disable-history:     true;
    display-drun:        "launch app:";
    display-run:         "run:";
}

window {
    location:         north;
    anchor:           north;
    x-offset:         0;
    y-offset:         200px;
    width:            560px;
    background-color: @background; /* Dynamic background */
    border:           0px;
    padding:          0px;
}

mainbox {
    orientation:      horizontal;
    children:         [ prompt-box, right-box ];
    spacing:          0px;
    background-color: transparent;
}

prompt-box {
    orientation:      vertical;
    expand:           false;
    children:         [ prompt, dummy-left ];
    spacing:          0px;
    background-color: transparent;
}

prompt {
    expand:           false;
    background-color: @selected-bg; /* Accent color matching wallpaper */
    text-color:       @background;  /* Dark text on active background */
    font:             "Departure Mono 10";
    padding:          3px 8px;
}

dummy-left {
    expand:           true;
    background-color: @background;
}

right-box {
    orientation:      vertical;
    expand:           true;
    children:         [ entry, listview ];
    spacing:          0px;
    background-color: transparent;
}

entry {
    expand:           false;
    background-color: @background;
    text-color:       @foreground;
    font:             "Departure Mono 10";
    padding:          3px 8px;
    placeholder:      "";
}


  listview {
      lines:            5;
      columns:          1;
      fixed-height:     true;
      dynamic:          false;
      scrollbar:        false;
      background-color: @background;
      spacing:          0px;
      padding:          0px;
      border:           0px;
      margin:           0px;
  }


element {
    orientation:      horizontal;
    children:         [ element-text ];
    padding:          3px 8px;
    border:           0px;
    background-color: transparent;
}

element selected.normal {
    background-color: @selected-bg; /* Accent background */
    text-color:       @background;  /* Dark text */
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    font:             "Departure Mono 10";
}

