/**
 * Rofi Minimal Aesthetic Deep Forest Green
 * Contrast: Low-fatigue matte background with a deep, earthy olive-forest green highlight.
 * Geometry: STICK TO SHARP CORNERS (0px border radius).
 */

configuration {
    /* --- Core Engine --- */
    modi:                       "drun,run";
    font:                       "JetBrainsMono Nerd Font 10";
    show-icons:                 false; /* Zero clutter minimal look */
    terminal:                   "foot";

    /* --- Clean Display Names --- */
    display-drun:               "APPS";
    display-run:                "RUN";

    /* --- Conflict Fixes & Vim Keys --- */
    kb-remove-to-eol:           "";              /* Clears Ctrl+k */
    kb-accept-entry:            "Return,KP_Enter"; /* Clears Ctrl+j */
    kb-row-up:                  "Up,Control+k";
    kb-row-down:                "Down,Control+j";
}

@import "~/.config/hypr/themes/active/rofi-colors.rasi"


/* --- Eye-Protection Color Palette --- */
@theme "/dev/null"

* {
    /* Highly aesthetic, desaturated matte backdrops */
    bg-base:     #232421; /* Soft near-black charcoal (earthy undertone) */
    bg-select:   #2d302a; /* Slightly elevated dark-greenish gray for input container */
    fg-light:    #ebdbb2; /* Soft Gruvbox cream (warm and natural) */
    fg-dim:      #7c6f64; /* Muted stone gray for helper text */
    
    /* Low-saturation deep forest/olive tones */
    forest-dark: #4f5b2a; /* Rich, mature olive-forest green (easy on eyes) */
    forest-glow: #6e7a3a; /* Lighter olive accent for borders */

    background-color: @bg-base;
    text-color:       @fg-light;
}

/* --- Window Layout (Perfectly Sharp & Centered) --- */
window {
    width:            25%;         /* Ultra-compact minimal width */
    border:           2px;         /* Flat border */
    border-color:     @forest-dark;/* Muted forest green frame */
    border-radius:    0px;         /* STRICTLY SHARP CORNERS */
    padding:          12px;
}

mainbox {
    spacing:          6px;
    children:         [ inputbar, listview ];
}

/* --- Input Bar --- */
inputbar {
    spacing:          0px;
    padding:          6px;
    background-color: @bg-select;  /* Distinct soft container */
    border:           0 0 1px 0;   /* Sharp bottom divider line */
    border-color:     @forest-glow;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @forest-glow;
    font:             "JetBrainsMono Nerd Font Bold 10";
    padding:          0px 8px 0px 4px;
}

entry {
    text-color:       @fg-light;
    placeholder:      "Type to search...";
    placeholder-color:@fg-dim;
}

/* --- Vertical List View --- */
listview {
    lines:            6;           /* Stays compact vertically */
    columns:          1;
    fixed-height:     true;
    spacing:          3px;
    padding:          6px 0px 0px 0px;
}

element {
    padding:          5px 8px;
    border-radius:    0px;         /* NO rounded corners */
}
/* --- Interactive States --- */
element selected {
    background-color: @forest-dark;/* Cozy, dark olive selection bar */
    text-color:       #fbf1c7;     /* High-contrast cream text over the deep green */
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}
